# Configuración del Sistema MCP
MCP_DEBUG=true
MCP_LOG_LEVEL=INFO
MCP_HOST=localhost
MCP_PORT=8080
MCP_WS_PORT=8081

# Base de datos
DATABASE_URL=sqlite:///./data/mcp_data.db
REDIS_URL=redis://localhost:6379

# Seguridad
SECRET_KEY=your-secret-key-here-change-in-production

# Monitoreo
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Plugins
PLUGINS_DIR=src/mcp/plugins
AUTO_LOAD_PLUGINS=true

# Logging
LOG_DIR=logs
LOG_FILE=mcp.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Performance
MAX_WORKERS=4
TIMEOUT_SECONDS=30
MAX_CONNECTIONS=100

# Features
ENABLE_WEBSOCKET=true
ENABLE_CORS=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true